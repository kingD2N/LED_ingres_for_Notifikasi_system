# Kontrol CPU/GPU per aplikasi (app IngresPerf).
# App mengisi semua properti sys.ingres.perf.* dari snapshot, lalu menaikkan
# sys.ingres.perf.apply sebagai pemicu terakhir. Properti kosong membuat write
# gagal tanpa efek (hanya tercatat di log init); app selalu mengisi semua kolom.
#
# Urutan penting karena kernel menolak min > max:
#   1) governor CPU, 2) <node>_floor -> min, 3) max -> max, 4) min target -> min.
# Governor GPU dan thermal tidak disentuh.

on property:sys.ingres.perf.apply=*
    # Governor CPU
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor ${sys.ingres.perf.cpu0_gov}
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor ${sys.ingres.perf.cpu4_gov}
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_governor ${sys.ingres.perf.cpu7_gov}

    # Turunkan min ke batas bawah kernel
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq ${sys.ingres.perf.cpu0_floor}
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq ${sys.ingres.perf.cpu4_floor}
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq ${sys.ingres.perf.cpu7_floor}
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq ${sys.ingres.perf.gpu_floor}

    # Set max target
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq ${sys.ingres.perf.cpu0_max}
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq ${sys.ingres.perf.cpu4_max}
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq ${sys.ingres.perf.cpu7_max}
    write /sys/class/kgsl/kgsl-3d0/devfreq/max_freq ${sys.ingres.perf.gpu_max}

    # Set min target
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq ${sys.ingres.perf.cpu0_min}
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq ${sys.ingres.perf.cpu4_min}
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq ${sys.ingres.perf.cpu7_min}
    write /sys/class/kgsl/kgsl-3d0/devfreq/min_freq ${sys.ingres.perf.gpu_min}
