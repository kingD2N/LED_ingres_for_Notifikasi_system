<!-- Ikon tile Setelan: bukan adaptive-icon karena Setelan hanya membaca meta-data ikon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_launcher_art"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp" />
</layer-list>
