//
// App IngresPerf: kontrol CPU/GPU per aplikasi. Logika murni di java/
// (diuji di host), perekat Android di kotlin/. Menulis sys.ingres.perf.*,
// init.ingres_perf.rc yang menulis sysfs.
//

android_app {
    name: "IngresPerf",
    package_name: "org.ingres.perf",
    manifest: "AndroidManifest.xml",
    srcs: [
        "kotlin/**/*.kt",
        "java/**/*.java",
    ],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    certificate: "platform",
    resource_dirs: ["res"],
    // UI Compose (ui/), pustaka sama dengan leds/app.
    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.compose.foundation_foundation",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.core_core-ktx",
    ],
    required: ["init.ingres_perf.rc"],
}
