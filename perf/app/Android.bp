//
// App IngresPerf: kontrol CPU/GPU per aplikasi. Logika murni di java/
// (diuji di host), perekat Android di kotlin/. Menulis sys.ingres.perf.*,
// init.ingres_perf.rc yang menulis sysfs.
//

android_app {
    name: "IngresPerf",
    package_name: "org.ingres.perf",
    manifest: "AndroidManifest.xml",
    srcs: [
        "kotlin/**/*.kt",
        "java/**/*.java",
    ],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    certificate: "platform",
    // UI (Compose) menambah resource_dirs dan static_libs di sini.
    required: ["init.ingres_perf.rc"],
}
