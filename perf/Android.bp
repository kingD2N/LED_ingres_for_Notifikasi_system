// Init rc kontrol CPU/GPU per aplikasi: menulis sysfs saat app IngresPerf
// mengubah sys.ingres.perf.apply. Diinstal ke /system_ext/etc/init.
prebuilt_etc {
    name: "init.ingres_perf.rc",
    src: "init/init.ingres_perf.rc",
    system_ext_specific: true,
    sub_dir: "init",
}
