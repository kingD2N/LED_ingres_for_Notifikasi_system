<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ingres.parts">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Aplikasi di depan untuk mode game (TaskStackListener). -->
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Overlay FPS & suhu. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Suhu CPU dari thermal HAL (IThermalService). -->
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <!-- Volume sementara saat membersihkan speaker. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".PartsApplication"
        android:directBootAware="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:persistent="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.IngresParts">

        <!-- Dibuka dari halaman utama Setelan (tanpa ikon di peluncur). -->
        <activity
            android:name=".ui.PartsActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:theme="@style/Theme.IngresParts">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_parts_tile" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="false" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/settings_summary" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-1" />
        </activity>

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
