# Properti sys.ingres.parts.*: app IngresParts (platform_app) menulis, init membaca lalu
# menulis sysfs lewat init.ingres_parts.rc.
system_internal_prop(ingres_parts_prop)

set_prop(platform_app, ingres_parts_prop)

# rc di system_ext berjalan di domain init. Profil thermal: thermal_message/sconfig
# (sysfs_thermal) dibaca mi_thermald untuk memilih thermal-*.conf.
allow init sysfs_thermal:file w_file_perms;

# Node vendor (baterai, sentuh, layar): aturannya di sepolicy/parts-vendor.
