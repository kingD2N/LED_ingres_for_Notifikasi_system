# Node GPU (kgsl): rc IngresPerf (system_ext) berjalan di domain init dan menulis
# /sys/class/kgsl/kgsl-3d0/devfreq/{min,max}_freq. Label node di ingres (dicek lewat
# ls -Z) adalah vendor_sysfs_kgsl. Dipasang hanya bila tipenya ada di source
# (lihat INGRES_ADDONS_KGSL_TYPE di BoardConfigAddons.mk).
allow init vendor_sysfs_kgsl:file w_file_perms;
allow init vendor_sysfs_kgsl:dir r_dir_perms;
# /sys/class/kgsl/kgsl-3d0/devfreq adalah symlink berlabel vendor_sysfs_kgsl; init harus
# membacanya untuk sampai ke max_freq. Tanpa ini write gagal "Permission denied" dan
# penolakannya tidak tercatat (dontaudit).
allow init vendor_sysfs_kgsl:lnk_file r_file_perms;

# App IngresPerf (platform_app) membaca daftar frekuensi dan nilai min/max GPU untuk UI
# dan snapshot. Tanpa ini bagian GPU di UI disembunyikan (Permission denied).
allow platform_app vendor_sysfs_kgsl:file r_file_perms;
allow platform_app vendor_sysfs_kgsl:dir r_dir_perms;
allow platform_app vendor_sysfs_kgsl:lnk_file r_file_perms;
