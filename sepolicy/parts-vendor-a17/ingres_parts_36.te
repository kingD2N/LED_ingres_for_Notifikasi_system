# Android 17: app IngresParts (target SDK < 37) berjalan sebagai platform_app_36
# (tipe publik, boleh dirujuk dari sepolicy vendor). Hanya dipasang di Android 17.
allow platform_app_36 vendor_sysfs_battery_supply:dir r_dir_perms;
allow platform_app_36 vendor_sysfs_battery_supply:file r_file_perms;
allow platform_app_36 vendor_sysfs_battery_supply:lnk_file r_file_perms;
allow platform_app_36 vendor_sysfs_touch:file r_file_perms;
allow platform_app_36 vendor_sysfs_graphics:dir r_dir_perms;
allow platform_app_36 vendor_sysfs_graphics:file r_file_perms;
allow platform_app_36 vendor_sysfs_graphics:lnk_file r_file_perms;
