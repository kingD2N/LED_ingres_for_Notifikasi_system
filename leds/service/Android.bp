cc_binary {
    name: "vendor.lineage.leds-service.ingres",
    system_ext_specific: true,
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.leds-service.ingres.rc"],
    srcs: ["Leds.cpp", "service.cpp"],
    cflags: ["-Wall", "-Werror"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "vendor.lineage.leds-ndk",
    ],
}
