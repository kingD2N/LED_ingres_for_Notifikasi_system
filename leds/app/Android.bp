//
// App Leds dari Ingres-Centre/android_packages_apps_leds (lineage-23.0),
// ditambah lampu status (notifikasi / baterai) untuk ingres.
//

android_app {
    name: "IngresLeds",
    package_name: "org.lineageos.leds",
    manifest: "AndroidManifest.xml",
    srcs: ["kotlin/**/*.kt"],
    resource_dirs: ["res"],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    certificate: "platform",
    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.compose.foundation_foundation",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.core_core-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.datastore_datastore",
        "libprotobuf-java-lite",
        "IngresLedsProto",
        "vendor.lineage.leds-java",
    ],
    required: ["vendor.lineage.leds-service.ingres"],
}

java_library {
    name: "IngresLedsProto",
    srcs: ["proto/**/*.proto"],
    proto: {
        type: "lite",
    },
    installable: false,
}
