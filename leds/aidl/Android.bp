// Interface LED aw22xxx untuk app Leds (Ingres-Centre) + lampu status.
// Service dan app sama-sama di system_ext, jadi interface tidak perlu
// stabilitas vintf (unstable).
aidl_interface {
    name: "vendor.lineage.leds",
    srcs: ["vendor/lineage/leds/*.aidl"],
    unstable: true,
    backend: {
        java: {
            enabled: true,
            platform_apis: true,
        },
        ndk: {
            enabled: true,
        },
        cpp: {
            enabled: false,
        },
    },
}
